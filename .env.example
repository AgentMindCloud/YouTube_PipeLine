# ── Script / voice / image generation (optional but recommended) ─────────
# Without it the pipeline still runs: seed scripts + free edge-tts + local visuals.
OPENAI_API_KEY=

# ── Stock photos (optional, free tier at pexels.com/api) ─────────────────
PEXELS_API_KEY=

# ── YouTube upload: option A (interactive OAuth) ─────────────────
# Just drop client_secrets.json in the project root and run:
#   python run.py auth login
# No env vars needed for option A.

# ── YouTube upload: option B (headless / CI) ─────────────────────
# For cron servers & GitHub Actions where a browser flow is impossible.
# Create the OAuth client once, run `python run.py auth login` locally,
# then copy the values out of output/token.json into your CI secrets.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
